{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "pool.turntide.561.group/public-pool-projection",
  "title": "TidepoolPublicProjection",
  "description": "Append-only public website projection of received pool-service publish-cycle-disclosure outputs. Each entry contains only the operation's public view plus source/receipt provenance; members-only disclosure is never stored here.",
  "type": "object",
  "required": [
    "$schema",
    "type",
    "state",
    "disclosures"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "type": {
      "const": "TidepoolPublicProjection"
    },
    "state": {
      "enum": [
        "unreceived",
        "received"
      ]
    },
    "disclosures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "public"
        ],
        "additionalProperties": false,
        "properties": {
          "source": {
            "type": "object",
            "required": [
              "producer",
              "operation",
              "operationReceipt",
              "recordNi",
              "recordRef",
              "importedAt",
              "cyclePublishedAt"
            ],
            "additionalProperties": false,
            "properties": {
              "producer": {
                "const": "@red-cup-engineering/pool-service"
              },
              "operation": {
                "const": "publish-cycle-disclosure"
              },
              "operationReceipt": {
                "type": "string",
                "pattern": "^ni:///sha-256;"
              },
              "recordNi": {
                "type": "string",
                "pattern": "^ni:///sha-256;"
              },
              "recordRef": {
                "type": "string",
                "minLength": 1
              },
              "importedAt": {
                "type": "string",
                "format": "date-time"
              },
              "cyclePublishedAt": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "public": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "roster",
              "cycle",
              "falsifiers"
            ],
            "properties": {
              "roster": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "enterpriseId",
                    "offer"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "enterpriseId": {
                      "type": "string",
                      "minLength": 1
                    },
                    "offer": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                }
              },
              "cycle": {
                "type": "object",
                "required": [
                  "cycleId",
                  "commodity",
                  "totalYield",
                  "reserve",
                  "float",
                  "distributable",
                  "fixedPortion",
                  "votedPortion",
                  "splitRatioPercent",
                  "perEnterpriseTotals",
                  "quorumMet",
                  "voteMode"
                ],
                "additionalProperties": false,
                "properties": {
                  "cycleId": {
                    "type": "string",
                    "minLength": 1
                  },
                  "commodity": {
                    "type": "string",
                    "minLength": 1
                  },
                  "totalYield": {
                    "type": "string"
                  },
                  "reserve": {
                    "type": "string"
                  },
                  "float": {
                    "type": "string"
                  },
                  "distributable": {
                    "type": "string"
                  },
                  "fixedPortion": {
                    "type": "string"
                  },
                  "votedPortion": {
                    "type": "string"
                  },
                  "splitRatioPercent": {
                    "type": "object",
                    "required": [
                      "reserve",
                      "float",
                      "distributable"
                    ],
                    "additionalProperties": false,
                    "properties": {
                      "reserve": {
                        "type": "integer"
                      },
                      "float": {
                        "type": "integer"
                      },
                      "distributable": {
                        "type": "integer"
                      }
                    }
                  },
                  "perEnterpriseTotals": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": [
                        "enterpriseId",
                        "total"
                      ],
                      "additionalProperties": false,
                      "properties": {
                        "enterpriseId": {
                          "type": "string",
                          "minLength": 1
                        },
                        "total": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  "quorumMet": {
                    "type": "boolean"
                  },
                  "voteMode": {
                    "enum": [
                      "weighted",
                      "equal-fallback"
                    ]
                  }
                }
              },
              "falsifiers": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "unreceived"
          }
        }
      },
      "then": {
        "properties": {
          "disclosures": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "received"
          }
        }
      },
      "then": {
        "properties": {
          "disclosures": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
